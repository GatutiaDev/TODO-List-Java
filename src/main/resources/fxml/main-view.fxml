<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.japinha.todolist.view.MainController"
            prefHeight="600" prefWidth="800">

    <top>
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <GridPane hgap="10" vgap="10">
                <TextField fx:id="campoTitulo" promptText="Título" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="campoPrioridade" promptText="Prioridade" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <ComboBox fx:id="campoCategoria" promptText="Categoria" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                <TextArea fx:id="campoDescricao" promptText="Descrição" prefRowCount="2"
                          GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.columnSpan="3"/>
            </GridPane>

            <HBox spacing="10">
                <Button fx:id="botaoSalvar" text="Salvar" onAction="#aoClicarSalvar"/>
                <Button fx:id="botaoCancelarEdicao" text="Cancelar edição" onAction="#aoClicarCancelarEdicao"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tabelaTarefas">
            <columns>
                <TableColumn fx:id="colunaTitulo" text="Título" prefWidth="140"/>
                <TableColumn fx:id="colunaDescricao" text="Descrição" prefWidth="200"/>
                <TableColumn fx:id="colunaStatus" text="Status" prefWidth="90"/>
                <TableColumn fx:id="colunaPrioridade" text="Prioridade" prefWidth="90"/>
                <TableColumn fx:id="colunaCategoria" text="Categoria" prefWidth="90"/>
                <TableColumn fx:id="colunaDataCriacao" text="Criada em" prefWidth="90"/>
                <TableColumn fx:id="colunaDataConcluido" text="Concluída em" prefWidth="90"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Button fx:id="botaoEditar" text="Editar selecionada" onAction="#aoClicarEditar"/>
            <Button fx:id="botaoConcluir" text="Concluir selecionada" onAction="#aoClicarConcluir"/>
            <Button fx:id="botaoExcluir" text="Excluir selecionada" onAction="#aoClicarExcluir"/>
        </HBox>
    </bottom>

</BorderPane>
